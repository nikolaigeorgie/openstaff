{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Staff",
  "version": "0.2.1",
  "identifier": "app.openstaff.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Open Staff",
        "width": 380,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3MjgzQzgzRUY0MTk1ODgKUldTSWxVSHZnendvdHhkczhORU9uRWN6ZE5FUVRqR3FSZUsxSlF0WkNHWUJHSXVXVWFzdWQwUmIK",
      "endpoints": [
        "https://openstaff-app.vercel.app/api/update/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
