{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @openstaff/web build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @openstaff/web start",
    "healthcheckPath": "/login",
    "restartPolicyType": "ON_FAILURE"
  }
}
